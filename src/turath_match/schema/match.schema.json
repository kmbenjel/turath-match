{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmbenjel/turath-match/schema/match.schema.json",
  "title": "turath-match match record (one line of matches.jsonl)",
  "type": "object",
  "required": ["left_scheme", "left_id", "right_scheme", "right_id", "level", "verdict", "method", "score",
               "confidence", "status", "evidence"],
  "properties": {
    "left_scheme": {"type": "string", "description": "library, wishlist, csv, shamela, waqfeya, openiti, archive …"},
    "left_id": {"type": "string"},
    "right_scheme": {"type": "string"},
    "right_id": {"type": "string"},
    "level": {"enum": ["work", "edition", "file"]},
    "verdict": {"enum": ["same", "related", "different", "uncertain"]},
    "relation": {"type": ["string", "null"], "enum": [null, "abridgement", "commentary", "gloss", "continuation",
      "selection", "versification", "refutation", "takhrij", "index", "study", "rearrangement", "part", "recension"]},
    "derived_side": {"type": ["string", "null"], "enum": [null, "left", "right"]},
    "method": {"enum": ["exact_size", "hash", "sampled_bytes", "exact_title_author", "fuzzy_title_author", "manual"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["match", "review", "no_match"]},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["kind", "detail", "weight"], "properties": {
        "kind": {"type": "string"}, "detail": {"type": "string"},
        "weight": {"type": "number", "minimum": -1, "maximum": 1}}}
    },
    "left_title": {"type": "string"}, "left_author": {"type": "string"},
    "right_title": {"type": "string"}, "right_author": {"type": "string"}, "right_url": {"type": "string"}
  }
}
